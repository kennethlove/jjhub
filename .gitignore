/target
.env

# story: beads tracking — only the JSONL export is versioned; the
# embedded dolt store, backups, and lock files are machine-local state.
.beads/*
!.beads/issues.jsonl
.beads.gate.lock

# story: runtime state — dev storage root (repos, meta) and generated
# SSH host keys; the server writes these on startup, never versioned.
data/
