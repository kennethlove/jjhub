# story: e05s02 + e40s01
#
# Builds the kata review sidecar at a pinned commit. The published
# ghcr.io/martint/kata image rejects anonymous pulls from here, so we build
# from source — OUR FORK (e40s01: chrome patch lands there; public so
# anonymous clone works) — and the commit hash pins the exact code.
#
# Mirrors kata's own Dockerfile: a bun stage builds the real web bundle,
# the rust stage embeds it (KATA_SKIP_WEB_BUILD skips a SECOND bun run in
# build.rs; the prebuilt dist is what ships). `serve` never needs the jj
# CLI, so the runtime stage stays slim.
FROM debian:bookworm-slim AS source
ARG KATA_REPO=https://github.com/kennethlove/kata.git
ARG KATA_COMMIT
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# WHY: Coolify passes --build-arg KATA_COMMIT bare with an empty value
# (coollabsio/coolify#7506); an explicit empty beats ARG and compose
# defaults alike, so the pin is a shell default at the use site. CI
# extracts it from this line — scripts/check-kata-pin.sh keeps it the
# only copy.
RUN git clone --quiet "${KATA_REPO}" /src \
 && git -C /src checkout --quiet "${KATA_COMMIT:-10b15bd75752a190b71db9881b5eb38628a23c53}"

# ---- web bundle (the review UI the /review links point at) ----
FROM oven/bun:1.3 AS frontend
WORKDIR /web
COPY --from=source /src/web/package.json /src/web/bun.lock ./
# WHY: cache mounts — dep installs and dep builds survive across builds on
# this builder; without them every deploy recompiles the world.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY --from=source /src/web ./
RUN bun run build

# ---- server binary, real web/dist embedded ----
FROM rust:1.99-bookworm AS backend
COPY --from=source /src /src
COPY --from=frontend /web/dist /src/web/dist
WORKDIR /src
ENV KATA_SKIP_WEB_BUILD=1
# WHY: same cache mounts as the app Dockerfile — the cached target dir is
# copied out (/kata) before the stage ends since mount contents never
# land in a layer.
RUN --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release -p kata-server \
 && cp target/release/kata /kata

FROM debian:bookworm-slim
# story: e18s03-note — curl feeds compose's healthcheck (curl /api/whoami);
# without it the healthcheck can only ever fail with `curl: not found`.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=backend /kata /usr/local/bin/kata
# Bind inside the container; compose decides host reachability.
ENV KATA_BIND=0.0.0.0:7878
ENV KATA_DATA=/data
ENV HOME=/home/kata
RUN mkdir -p /data /home/kata && chmod 0777 /data /home/kata
VOLUME ["/data"]
EXPOSE 7878
ENTRYPOINT ["kata"]
CMD ["--help"]
