# story: e02s01 — copy to .env and fill in. Every variable the server
# reads, grouped by subsystem; commented = optional unless noted.
# docker-compose.yml only forwards the mail/SMTP + core vars; the rest
# are read by direct runs (cargo run) or other compose services.

# --- required ---
POSTGRES_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# story: e18s01 — load the optional host-port file so `docker compose up -d`
# publishes http://localhost:3000. A Coolify clone ships no .env, so the base
# docker-compose.yml alone binds no host port.
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yaml
JJHUB_BIND_HTTP=3000:3000
# SSH publish opt-in: also uncomment the SSH line in docker-compose.ports.yaml
# JJHUB_BIND_SSH=2202:2202

# --- server (optional; defaults shown) ---
# JJHUB_PORT=3000                  # direct-run HTTP port
# JJHUB_STORAGE_ROOT=./data/repos  # compose sets /var/lib/jjhub/repos
# JJHUB_LOG_DIR=data/logs          # mail_log + retention lines live here
# JJHUB_OPERATOR=                  # handle granted /admin; unset = nobody
# JJHUB_BIN=                       # git binary; unset = auto-detect
# JJHUB_ARGON2_M_COST=             # unset = RFC 9106 default; minimum 8

# --- mail (v0.7.0 arm) ---
# JJHUB_EMAIL_PROVIDER unset, or any value other than the three below,
# silently falls back to the LogMailer: sends land in the log, NOT in
# mailboxes. This is the var that must be set for real mail.
# JJHUB_EMAIL_PROVIDER=resend      # resend | smtp | messagepit
# RESEND_API_KEY=                  # required (panic at boot) when provider=resend
# JJHUB_MAIL_FROM=jjhub@localhost  # resend rejects an unverified sender domain
# JJHUB_EMAIL_CONFIRM=off          # default ON; =off skips confirmation emails
# SMTP relay (provider=smtp). Blank = unset.
# JJHUB_SMTP_HOST=                 # default 127.0.0.1; Resend = smtp.resend.com
# JJHUB_SMTP_PORT=587              # 465 = SMTPS (implicit TLS); 587 = STARTTLS
#                                   # (required upgrade) — mode follows the port
# JJHUB_SMTP_USERNAME=
# JJHUB_SMTP_PASSWORD=
# Messagepit arm (provider=messagepit):
# JJHUB_MESSAGEPIT_URL=http://127.0.0.1:8100
# MP_SENDGRID_API_KEY=

# --- ssh (optional; enabled by default) ---
# JJHUB_SSH_ENABLED=on             # 1/true/yes/on or 0/false/no/off
# JJHUB_SSH_BIND=0.0.0.0
# JJHUB_SSH_PORT=2202
# JJHUB_SSH_HOST_KEY_DIR=./data/host-keys

# --- captcha (both keys set = challenge on signup; unset = off) ---
# JJHUB_CAPTCHA_SITE_KEY=
# JJHUB_CAPTCHA_SECRET_KEY=
# JJHUB_CAPTCHA_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- kata review sidecar ---
# KATA_UPSTREAM=http://127.0.0.1:7878   # compose sets http://kata:7878
# KATA_PUBLIC_BASE=                     # unset = same-origin relative links
