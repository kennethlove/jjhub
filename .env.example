# story: e02s01 — copy to .env and fill in
POSTGRES_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# story: e18s01 — load the optional host-port file so `docker compose up -d`
# publishes http://localhost:3000. A Coolify clone ships no .env, so the base
# docker-compose.yml alone binds no host port.
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yaml
JJHUB_BIND_HTTP=3000:3000
# SSH publish opt-in: also uncomment the SSH line in docker-compose.ports.yaml
# JJHUB_BIND_SSH=2202:2202
